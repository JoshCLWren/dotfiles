{
  "disable_ai": true,
  "tab_size": 2,
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "minimum_contrast_for_highlights": 46.0,
  "agent_ui_font_size": 16.0,
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "on_last_window_closed": "quit_app",
  "when_closing_with_no_tabs": "close_window",
  "theme": "Monokai-og",
  "edit_predictions": {
    "provider": "copilot",
    "mode": "eager",
  },
  "autosave": "on_focus_change",
  "terminal": {
    "env": {
      "PYTEST_ADDOPTS": "-sv --no-cov",
    },
  },
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff"],
      "formatter": {
        "language_server": { "name": "ruff" }
      },
    },
    "CSharp": {
      "language_servers": ["roslyn"],
    },
    "TypeScript": {
      "language_servers": ["typescript-language-server"],
    },
    "TSX": {
      "language_servers": ["typescript-language-server"],
    },
    "Go": {
      "language_servers": ["gopls"],
    },
  },
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          "configuration": "/Users/joshwren/code/youversion/yv-standards/yv_standards/configs/base.toml",
        },
      },
    },
    "ty": {
      "settings": {
        "configurationFile": "/Users/joshwren/code/youversion/yv-standards/yv_standards/configs/ty.toml",
      },
    },
  },
  "buffer_font_features": {
    "calt": false,
  },
}
